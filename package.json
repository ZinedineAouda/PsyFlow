{
  "name": "psyflow",
  "productName": "PsyFlow",
  "version": "1.0.0",
  "description": "Patient Management & Genogram Maker",
  "author": "PsyFlow Team",
  "license": "ISC",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently \"node server.js\" \"wait-on http://localhost:5000 && electron .\"",
    "build:exe": "electron-builder build --win"
  },
  "keywords": [
    "ehr",
    "genogram",
    "clinical"
  ],
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^30.0.1",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.psyflow.manager",
    "productName": "PsyFlow",
    "win": {
      "target": "portable",
      "icon": "public/icon.png"
    },
    "directories": {
      "output": "dist"
    }
  }
}
